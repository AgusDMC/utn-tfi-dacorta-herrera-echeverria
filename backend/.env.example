# Variables del backend. Copiar como backend/.env y completar.
# Spring lo lee solo al arrancar desde backend/.

# Base de datos local
DB_USERNAME=inmobiliaria
DB_PASSWORD=inmobiliaria

# Clave para firmar los JWT (generar con: openssl rand -base64 48)
JWT_SECRET=cambiar-por-un-secreto-largo

# Correo (Brevo). Sin credenciales reales falla el alta de consultas.
MAIL_USERNAME=sin-configurar
MAIL_PASSWORD=sin-configurar
EMAIL_REMITENTE=no-responder@demo.local
NOMBRE_REMITENTE=Inmobiliaria Demo
EMAIL_DESTINATARIO=admin@demo.local
